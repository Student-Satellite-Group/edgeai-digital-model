# Copy this file to .env and fill in your real credentials.
# .env is git-ignored — never commit real credentials.

# Copernicus / Sentinel data access (scihub.copernicus.eu)
COPERNICUS_USERNAME=your_username
COPERNICUS_PASSWORD=your_password

# USGS EarthExplorer (Landsat Collection 2 Level 2 — thermal bands)
USGS_USERNAME=your_username
USGS_PASSWORD=your_password